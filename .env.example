# 服务端环境变量配置模板
# 复制为 .env 并填写实际值，切勿将 .env 提交到版本库

# ── 必须配置 ──
# JWT 签名密钥，至少32位随机字符串
# 生成命令: openssl rand -hex 32
JWT_SECRET=your-very-long-random-secret-at-least-32-chars

# ── 可选配置（有默认值） ──
# 服务监听端口
PORT=4000

# CORS 允许的来源，多个用逗号分隔，生产环境务必限制
# 示例: https://your-domain.com,https://admin.your-domain.com
# 默认 * 表示允许所有来源（不推荐生产环境）
CORS_ORIGIN=*

# 管理员账号（首次启动时创建）
ADMIN_USERNAME=admin
# 不设置则首次启动自动生成随机密码并打印到控制台
ADMIN_PASSWORD=

# 数据库文件路径
# DB_PATH=./data/fitness.db

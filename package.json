{
  "name": "bodydata-app",
  "version": "2.0.0",
  "main": "index.js",
  "description": "身体数据记录 - 裸 React Native + React Native Web，支持 Android/iOS/Web，附带服务端数据管理后台",
  "scripts": {
    "start": "react-native start",
    "dev": "node scripts/dev.mjs",
    "android": "react-native run-android",
    "ios": "react-native run-ios",
    "web": "webpack serve --mode development --config webpack/webpack.config.js",
    "web:build": "webpack --mode production --config webpack/webpack.config.js",
    "typecheck": "tsc --noEmit",
    "init:native": "node scripts/init-native-dirs.js",
    "build:apk": "cd android && gradlew assembleRelease",
    "server": "cd server && npm start",
    "admin:dev": "cd admin && npm run dev",
    "admin:build": "cd admin && npm run build"
  },
  "dependencies": {
    "@op-engineering/op-sqlite": "^18.1.4",
    "@react-native-async-storage/async-storage": "2.1.0",
    "@react-navigation/bottom-tabs": "^7.3.0",
    "@react-navigation/native": "^7.1.0",
    "@react-navigation/native-stack": "^7.1.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-native": "0.79.2",
    "react-native-document-picker": "^9.3.1",
    "react-native-fs": "^2.20.0",
    "react-native-gesture-handler": "~2.24.0",
    "react-native-linear-gradient": "^2.8.3",
    "react-native-reanimated": "~3.17.0",
    "react-native-safe-area-context": "5.4.0",
    "react-native-screens": "~4.10.0",
    "react-native-share": "^12.3.1",
    "react-native-svg": "15.11.0",
    "react-native-vector-icons": "^10.3.0",
    "react-native-web": "^0.21.2",
    "sql.js": "^1.11.0",
    "zustand": "^4.5.5"
  },
  "devDependencies": {
    "@babel/core": "^7.26.0",
    "@babel/plugin-transform-runtime": "^7.26.0",
    "@babel/preset-env": "^7.26.0",
    "@babel/preset-react": "^7.29.7",
    "@babel/preset-typescript": "^7.26.0",
    "@babel/runtime": "^7.26.0",
    "@pmmmwh/react-refresh-webpack-plugin": "^0.5.15",
    "@react-native-community/cli": "^15.0.0",
    "@react-native-community/cli-platform-android": "^15.0.0",
    "@react-native-community/cli-platform-ios": "^15.0.0",
    "@react-native/babel-preset": "^0.79.7",
    "@types/node": "^20.19.43",
    "@types/react": "^19.2.8",
    "@types/react-native-vector-icons": "^6.4.18",
    "@types/sql.js": "^1.4.9",
    "babel-loader": "^9.2.1",
    "babel-plugin-module-resolver": "^5.0.2",
    "babel-plugin-react-native-web": "^0.21.2",
    "copy-webpack-plugin": "^12.0.2",
    "css-loader": "^7.1.2",
    "html-webpack-plugin": "^5.6.3",
    "process": "^0.11.10",
    "react-refresh": "^0.16.0",
    "style-loader": "^4.0.0",
    "typescript": "^5.7.0",
    "url-loader": "^4.1.1",
    "webpack": "^5.96.1",
    "webpack-cli": "^5.1.4",
    "webpack-dev-server": "^5.1.0"
  },
  "private": true
}

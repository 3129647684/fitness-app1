{
  "name": "bodydata-app",
  "version": "1.0.0",
  "main": "expo-router/entry",
  "scripts": {
    "start": "expo start",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "web": "expo start --web",
    "patch": "node scripts/patch-expo-modules-core.js && node scripts/patch-esm-imports.js && node scripts/patch-metro-exports.js && node scripts/patch-non-ascii-paths.js",
    "build:apk": "npx expo prebuild --platform android && cd android && ./gradlew assembleRelease"
  },
  "dependencies": {
    "@expo/vector-icons": "~14.1.0",
    "@react-native-async-storage/async-storage": "2.1.0",
    "@react-navigation/bottom-tabs": "^7.3.0",
    "@react-navigation/native": "^7.1.0",
    "expo": "~53.0.0",
    "expo-constants": "~17.1.0",
    "expo-document-picker": "~13.1.0",
    "expo-file-system": "~18.1.0",
    "expo-haptics": "~14.1.0",
    "expo-linear-gradient": "~14.1.5",
    "expo-linking": "~7.1.0",
    "expo-notifications": "~0.31.0",
    "expo-router": "~5.0.0",
    "expo-sharing": "~13.1.0",
    "expo-sqlite": "~15.2.14",
    "expo-status-bar": "~2.2.0",
    "react": "19.0.0",
    "react-dom": "^19.0.0",
    "react-native": "0.79.2",
    "react-native-gesture-handler": "~2.24.0",
    "react-native-reanimated": "~3.17.0",
    "react-native-safe-area-context": "5.4.0",
    "react-native-screens": "~4.10.0",
    "react-native-svg": "15.11.0",
    "react-native-web": "^0.20.0",
    "zustand": "^4.5.5"

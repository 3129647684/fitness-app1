    "@react-navigation/native-stack": "^7.1.0",
    "expo": "^57.0.17",
    "expo-constants": "^57.0.15",
    "expo-document-picker": "^57.0.1",
    "expo-file-system": "^57.0.6",
    "expo-font": "^57.0.1",
    "expo-linking": "^57.0.8",
    "expo-modules-core": "^57.0.14",

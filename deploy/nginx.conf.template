server {
    listen 80;
    server_name _;

    client_max_body_size 20M;

    access_log /var/log/nginx/bodydata-access.log;
    error_log  /var/log/nginx/bodydata-error.log;

    location /api/ {
        proxy_pass http://127.0.0.1:4000/;
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection "upgrade";
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_read_timeout 300s;
        proxy_connect_timeout 75s;
        proxy_send_timeout 300s;
    }

    location /admin/ {
        alias /var/www/bodydata-admin/;
        index index.html;
        try_files $uri $uri/ /admin/index.html;
    }

    location / {
        alias /var/www/bodydata-app/;
        index index.html;
        try_files $uri $uri/ /index.html;
    }

    location ~* \.(wasm|js|css|png|jpg|jpeg|gif|svg|ico|woff|woff2|ttf)$ {
        expires 7d;
        add_header Cache-Control "public, immutable";
    }
}
